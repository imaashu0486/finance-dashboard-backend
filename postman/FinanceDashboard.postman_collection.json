            ],
            "url": "{{baseUrl}}/api/dashboard/net-balance"
          }
        },
        {
          "name": "GET /api/dashboard/category-wise",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{analystAccessToken}}" },
              { "key": "x-role", "value": "analyst" }
            ],
            "url": "{{baseUrl}}/api/dashboard/category-wise"
