              { "key": "Authorization", "value": "Bearer {{analystAccessToken}}" },
              { "key": "x-role", "value": "analyst" }
            ],
            "url": "{{baseUrl}}/api/dashboard/monthly-trends"
          }
        },
        {
          "name": "GET /api/dashboard/last-transactions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{analystAccessToken}}" },
              { "key": "x-role", "value": "analyst" }
            ],
            "url": "{{baseUrl}}/api/dashboard/last-transactions?limit=5"
          }
        },
        {
          "name": "GET /api/dashboard/top-expense-categories",
          "request": {
