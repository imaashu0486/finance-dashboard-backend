              { "key": "Authorization", "value": "Bearer {{analystAccessToken}}" },
              { "key": "x-role", "value": "analyst" }
            ],
            "url": "{{baseUrl}}/api/dashboard/summary?startDate=2026-01-01&endDate=2026-12-31"
          }
        },
        {
          "name": "GET /api/dashboard/summary viewer forbidden",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{viewerAccessToken}}" },
              { "key": "x-role", "value": "viewer" }
            ],
            "url": "{{baseUrl}}/api/dashboard/summary"
          }
        }
      ]
    }
  ]
}
