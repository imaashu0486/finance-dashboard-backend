NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/finance_dashboard
JWT_SECRET=replace_with_strong_access_token_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_strong_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=accessToken
AUTH_REFRESH_COOKIE_NAME=refreshToken
SWAGGER_SERVER_URL=http://localhost:5000
